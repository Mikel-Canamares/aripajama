# Local web development never sends real messages.
# Complete personal reception tests use the production Worker and its own secrets.
ENVIRONMENT=development
EMAIL_MODE=disabled
EMAIL_TEST_RESTRICTED=true
EMAIL_TEST_RECIPIENTS=mikel.canamares@gmail.com
TURNSTILE_MODE=mock
