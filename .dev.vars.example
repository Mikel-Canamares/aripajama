# Local web development never sends real messages.
# Complete personal reception tests use the production Worker and its own secrets.
ENVIRONMENT=development
EMAIL_MODE=disabled
EMAIL_TEST_RESTRICTED=true
EMAIL_TEST_RECIPIENTS=mikel.canamares@gmail.com
# For simulated email previews only, set EMAIL_MODE=mock.
# Set production values through Cloudflare variables/secrets, not in this file.
RESEND_API_KEY=
EMAIL_FROM=Aripajama <perfil@notificaciones.aripajama.com>
REPLY_TO=hola@aripajama.com
PUBLIC_SITE_URL=
WHATSAPP_URL=
# Local automated-development defaults; personal tests use the production Worker.
BOOKING_ENABLED=false
CAL_BOOKING_URL=
# Secreto del webhook Booking Created de este entorno, solo en el Worker.
CAL_WEBHOOK_SECRET=
# Activar para probar el aviso interno con EMAIL_MODE=mock y ARIANA_EMAIL.
BOOKING_NOTIFICATIONS_ENABLED=false
ARIANA_EMAIL=mikel.canamares@gmail.com
