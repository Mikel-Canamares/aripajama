REPLY_TO=hola@aripajama.com
PUBLIC_SITE_URL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
WHATSAPP_URL=
# Local automated-development defaults; personal tests use the production Worker.
BOOKING_ENABLED=false
CAL_BOOKING_URL=
BOOKING_NOTIFICATIONS_ENABLED=false
