{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "types": [], "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["server", "src/data/trip-request.ts"], "exclude": ["server/tests"]
}
